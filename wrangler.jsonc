{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers (static assets) — the cloud deployment target.
  //
  // The homelab container is untouched: nginx.conf still serves it and this
  // file is inert there. Pages was the original target (see public/_headers),
  // but the dashboard now steers new projects to Workers, and Workers is the
  // better fit anyway: unlike Pages, a Git repo CAN be connected to an existing
  // Worker (Settings > Builds > Connect), so the "git integration cannot be
  // retrofitted" trap that Pages has does not apply.
  //
  // ⚠ `name` MUST match the Worker name in the Cloudflare dashboard exactly, or
  // every Workers Build fails. See
  // developers.cloudflare.com/workers/ci-cd/builds/troubleshoot/#workers-name-requirement
  //
  // This says `learning-indonesian`, not the product name "kamoebisa", because
  // the Workers Builds wizard auto-names the Worker after the GitHub repo and a
  // Worker cannot be renamed after creation (you would delete and recreate it).
  // The first build failed on exactly this mismatch, 2026-07-31.
  //
  // The name is cosmetic: it only surfaces in the temporary
  // learning-indonesian.avduijn.workers.dev URL. The customer-facing hostname
  // will be the kamoebisa.nl custom domain attached to this same Worker, after
  // which the workers.dev subdomain can be disabled outright.
  "name": "learning-indonesian",

  "compatibility_date": "2026-07-31",

  // Serve on learning-indonesian.avduijn.workers.dev. Explicit because the
  // dashboard's template Worker left the subdomain DISABLED
  // (`{enabled: false, previews_enabled: false}`), which is what produced
  // Cloudflare's "There is nothing here yet" page instead of the app.
  // Once kamoebisa.nl is attached as a custom domain this can flip to false to
  // take the workers.dev hostname out of service.
  "workers_dev": true,

  "assets": {
    // `bun run build` (tsc -b && vite build) emits here, including _headers and
    // _redirects, which Workers static assets supports natively — same file
    // format as Pages, so the CSP ported from nginx.conf:50-64 carries over
    // unchanged.
    "directory": "./dist",

    // Replaces nginx's `try_files $uri $uri/ /index.html` (nginx.conf:67).
    // Without it every deep link (/leren, /lesson/<id>, /checkout/success)
    // 404s on a hard refresh, because only "/" is a real file — React Router
    // owns every other path.
    //
    // Pages inferred SPA behaviour from the presence of index.html; Workers
    // makes it explicit and returns a bare 404 if unset, so this line is
    // load-bearing rather than decorative.
    //
    // NOTE: public/_redirects also carries a `/* /index.html 200` rule, which
    // is the Pages-portable form of the same thing. That overlap is deliberate
    // for now — the first successful deploy should confirm which mechanism is
    // actually serving deep links, and the redundant one then gets removed.
    "not_found_handling": "single-page-application"
  }

  // No `main` and no `binding`: this Worker is assets-only, with no server-side
  // script. The app talks to Supabase Cloud directly from the browser, exactly
  // as it does on the homelab. `binding` is only valid alongside `main`.
}
